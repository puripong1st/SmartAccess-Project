{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "manual-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "http-server", ".", "-p", "8099", "-c-1"],
      "port": 8099
    },
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "my-app", "run", "dev"],
      "port": 3000
    },
    {
      "name": "next-start",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "my-app", "run", "start"],
      "port": 3000
    }
  ]
}
